<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/TXVTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/appTitle"
        android:textSize="@dimen/textSizeTitle"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/marginTop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <GridLayout
        android:id="@+id/GRLTablero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/marginTop"
        android:columnCount="3"
        android:rowCount="3"
        android:alignmentMode="alignMargins"
        app:layout_constraintTop_toBottomOf="@id/TXVTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <Button android:id="@+id/btnCasilla0" android:layout_width="90dp" android:layout_height="90dp" android:layout_margin="4dp" android:textSize="32sp" android:layout_row="0" android:layout_column="0" />
        <Button android:id="@+id/btnCasilla1" android:layout_width="90dp" android:layout_height="90dp" android:layout_margin="4dp" android:textSize="32sp" android:layout_row="0" android:layout_column="1" />
        <Button android:id="@+id/btnCasilla2" android:layout_width="90dp" android:layout_height="90dp" android:layout_margin="4dp" android:textSize="32sp" android:layout_row="0" android:layout_column="2" />

        <Button android:id="@+id/btnCasilla3" android:layout_width="90dp" android:layout_height="90dp" android:layout_margin="4dp" android:textSize="32sp" android:layout_row="1" android:layout_column="0" />
        <Button android:id="@+id/btnCasilla4" android:layout_width="90dp" android:layout_height="90dp" android:layout_margin="4dp" android:textSize="32sp" android:layout_row="1" android:layout_column="1" />
        <Button android:id="@+id/btnCasilla5" android:layout_width="90dp" android:layout_height="90dp" android:layout_margin="4dp" android:textSize="32sp" android:layout_row="1" android:layout_column="2" />

        <Button android:id="@+id/btnCasilla6" android:layout_width="90dp" android:layout_height="90dp" android:layout_margin="4dp" android:textSize="32sp" android:layout_row="2" android:layout_column="0" />
        <Button android:id="@+id/btnCasilla7" android:layout_width="90dp" android:layout_height="90dp" android:layout_margin="4dp" android:textSize="32sp" android:layout_row="2" android:layout_column="1" />
        <Button android:id="@+id/btnCasilla8" android:layout_width="90dp" android:layout_height="90dp" android:layout_margin="4dp" android:textSize="32sp" android:layout_row="2" android:layout_column="2" />

    </GridLayout>

    <TextView
        android:id="@+id/TXVEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/marginTop"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/GRLTablero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Reiniciar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/TXVEstado" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        tools:layout_editor_absoluteX="176dp"
        tools:layout_editor_absoluteY="470dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
